FROM node:20-alpine

# Set the environment variable to increase Node.js memory limit
ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN apk add --no-cache git gettext

WORKDIR /usr/src/app

ENV PATH /usr/src/app/node_modules/.bin:$PATH

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies
RUN npm cache clear --force
RUN npm config set fetch-retry-maxtimeout 120000
RUN npm config set registry https://registry.npmjs.org/ --location=global
RUN npm install --location=global @angular/cli@14.2.12
RUN npm install

# Copy source code
COPY . .

# Expose port for Angular dev server
EXPOSE 4200

# Create a startup script to handle environment variables
RUN echo '#!/bin/sh' > /usr/src/app/start-dev.sh && \
    echo 'npm run env || true' >> /usr/src/app/start-dev.sh && \
    echo 'envsubst < /usr/src/app/src/assets/env.template.js > /usr/src/app/src/assets/env.js' >> /usr/src/app/start-dev.sh && \
    echo 'ng serve --host 0.0.0.0 --port 4200 --poll 2000 --disable-host-check' >> /usr/src/app/start-dev.sh && \
    chmod +x /usr/src/app/start-dev.sh

# Start Angular dev server with environment variables
CMD ["/usr/src/app/start-dev.sh"]
